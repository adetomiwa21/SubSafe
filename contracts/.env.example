# Wallet that deploys SubSafe (needs a little tBOT for gas). NEVER commit your real .env
PRIVATE_KEY=0xyour_private_key_here
BOTCHAIN_RPC=https://rpc.bohr.life
# Official BOTChain testnet USDT (6 decimals)
USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
# Where protocol fees go (defaults to deployer)
TREASURY=
# Protocol fee in basis points (100 = 1%, max 500)
FEE_BPS=100
# Set after deploying (used by scripts/keeper.js)
SUBSAFE_ADDRESS=
# Mainnet: your own wallet that should own the contract and receive the protocol fee
OWNER=
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai
